+def _blind_rollout_card(seat: int, hand: list[str], trick: list[tuple[int, str]], ctx: _Context) -> str:
+    """Approximate a blind simulated seat without its world's hidden call or hands.
 
+    Known critical cards can beat each other regardless of the call. Other
+    decisions use only printed ranks and suits, the public trick and this
+    simulated player's own cards. This is a simple model, not a human policy.
+    """
+    protected = _CRITICAL_SCORE if ctx.critical else (WELI,)
+    candidates = hand
+    if len(trick) == ctx.count - 1:
+        played = [(player, card) for player, card in trick if ctx.critical and card in _CRITICAL_SCORE]
+        if played:
+            winner, highest = max(played, key=lambda item: _CRITICAL_SCORE[item[1]])
+            if ctx.parties[winner] != ctx.parties[seat]:
+                covers = [card for card in hand if card in _CRITICAL_SCORE
+                          and _CRITICAL_SCORE[card] > _CRITICAL_SCORE[highest]]
+                if covers:
+                    return min(covers, key=lambda card: (_CRITICAL_SCORE[card], card))
+        elif WELI not in (card for _, card in trick):
+            # A blind seat may try the apparent led-suit winner without
+            # knowing whether the hidden call changes the actual result.
+            led_suit = card_suit(trick[0][1])
+            led = [(player, card) for player, card in trick if card_suit(card) == led_suit]
+            apparent_winner, apparent = max(led, key=lambda item: _BLIND_RANK_ORDER[card_rank(item[1])])
+            if ctx.parties[apparent_winner] != ctx.parties[seat]:
+                winning = [card for card in hand if card not in protected and card_suit(card) == led_suit
+                           and _BLIND_RANK_ORDER[card_rank(card)] > _BLIND_RANK_ORDER[card_rank(apparent)]]
+                if winning:
+                    return min(winning, key=lambda card: (_BLIND_RANK_ORDER[card_rank(card)], card))
+            else:
+                # Keep an apparently leading partner in front when another
+                # choice is available; the unknown call can still change it.
+                other = [card for card in hand if card_suit(card) != led_suit
+                         or _BLIND_RANK_ORDER[card_rank(card)] <= _BLIND_RANK_ORDER[card_rank(apparent)]]
+                if other:
+                    candidates = other
+    used_ranks = {card_rank(card) for _, card in trick}
+    return min(candidates, key=lambda card: (card in protected, card_rank(card) in used_ranks,
+                                             _BLIND_RANK_ORDER[card_rank(card)], card))
+
+
+def _deduced_rollout_card(model: _Model, seat: int, hand: list[str], trick: list[tuple[int, str]],
+                          ctx: _Context) -> str:
+    """Use this seat's uniquely deduced call without reading any other hand."""
+    cheapest = min(hand, key=model.order.__getitem__)
+    if not trick:
+        return cheapest
+    cards = [card for _, card in trick]
+    best_index = model.winner(cards)
+    if ctx.parties[trick[best_index][0]] == ctx.parties[seat]:
+        return cheapest
+    best = model.strength(cards[best_index], cards[0])
+    winners = [card for card in hand if model.strength(card, cards[0]) > best]
+    return min(winners, key=model.order.__getitem__) if winners else cheapest
+
