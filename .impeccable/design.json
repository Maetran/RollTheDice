      "css": ".ds-secondary{font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:12px;min-height:44px;padding:0 13px;border:1px solid #52634f;border-radius:6px;background:#18211a;color:var(--text,#edf2e9);cursor:pointer;}.ds-secondary:hover:not(:disabled){background:#253320;border-color:#a8ce78;color:var(--cyan,#c4f279);}.ds-secondary:focus-visible{outline:2px solid var(--cyan,#c4f279);outline-offset:4px;}.ds-secondary:disabled{opacity:.65;cursor:default;}"
    },
    {
      "name": "NEXUS filter select",
      "kind": "input",
      "refersTo": "nexus-select",
      "description": "A labeled native filter, preserving platform interaction.",
      "html": "<label class=\"ds-field\"><span>Zeitraum</span><select><option>7 Tage</option><option>30 Tage</option></select></label>",
      "css": ".ds-field{font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:inline-flex;align-items:center;gap:12px;color:var(--muted,#a6b6ab);font-size:12px;}.ds-field select{font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;min-height:44px;min-width:126px;padding:0 12px;border:1px solid #52634f;border-radius:6px;background:#18211a;color:var(--text,#edf2e9);}.ds-field select:hover{background:#253320;border-color:#a8ce78;color:var(--cyan,#c4f279);}.ds-field select:focus-visible{outline:2px solid var(--cyan,#c4f279);outline-offset:4px;}"
    },
    {
      "name": "NEXUS navigation link",
      "kind": "nav",
      "refersTo": "nexus-navigation",
      "description": "Text and inline instrument icon, stacked in the desktop rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Dashboard-Bereiche\"><a href=\"#dashboardFavorites\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 3 2.78 5.64L21 9.55l-4.5 4.39 1.06 6.2L12 17.21l-5.56 2.93 1.06-6.2L3 9.55l6.22-.91Z\"/></svg><span>Favoriten</span></a><a href=\"#overviewMetrics\">Kennzahlen</a></nav>",
      "css": ".ds-nav{font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;display:flex;flex-direction:column;gap:7px;font-size:13px;color:var(--muted,#a6b6ab);}.ds-nav a{display:flex;align-items:center;gap:10px;min-height:47px;padding:0 16px;border-radius:6px;color:inherit;text-decoration:none;}.ds-nav a:first-child{background:#26341d;color:var(--cyan,#c4f279);}.ds-nav a:hover{background:#263320;color:var(--cyan,#c4f279);}.ds-nav a:focus-visible{outline:2px solid var(--cyan,#c4f279);outline-offset:4px;}.ds-nav svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.5;}"
    },
    {
      "name": "NEXUS country-code tag",
      "kind": "chip",
      "refersTo": "nexus-country-tag",
      "description": "Compact code inside the selected-country instrument.",
      "html": "<span class=\"ds-country\">CH</span>",
      "css": ".ds-country{display:grid;place-items:center;width:35px;height:35px;border:1px solid #617c40;border-radius:4px;background:#23301e;color:var(--cyan,#c4f279);font:12px var(--mono,ui-monospace,monospace);}"
    },
    {
      "name": "NEXUS KPI cell",
      "kind": "card",
      "refersTo": "nexus-metric",
      "description": "A measured value with its scope hint; the enclosing deck owns the rounded edge.",
      "html": "<article class=\"ds-metric\"><span class=\"ds-metric-label\">Besuche</span><strong class=\"ds-metric-value\">—</strong><p class=\"ds-metric-hint\">Anonyme Browser-Tab-Sitzungen</p></article>",
      "css": ".ds-metric{font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;padding:22px 24px 20px;min-height:166px;background:var(--panel,#141b18);color:var(--text,#edf2e9);outline:1px solid var(--line,#344139);}.ds-metric-label{display:block;color:var(--muted,#a6b6ab);font-size:13px;line-height:1.5;}.ds-metric-value{display:block;margin-top:13px;font:500 clamp(28px,3.2vw,46px)/1.2 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;letter-spacing:-.035em;font-variant-numeric:tabular-nums;}.ds-metric-hint{margin:8px 0 0;font-size:12px;color:var(--muted,#a6b6ab);line-height:1.6;}"
    },
    {
      "name": "NEXUS analysis panel",
      "kind": "card",
      "refersTo": "nexus-panel",
      "description": "Flat ruled bay with the existing heading and explanatory copy rhythm.",
      "html": "<article class=\"ds-panel\"><h3>Besuche im Verlauf</h3><p>Besuche und Seitenaufrufe je UTC-Tag</p></article>",
      "css": ".ds-panel{font-family:ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;padding:24px;border:1px solid var(--line,#344139);border-radius:12px;background:var(--panel,#141b18);color:var(--text,#edf2e9);box-shadow:none;transition:border-color .25s,box-shadow .25s;}.ds-panel:hover{border-color:#36536a;}.ds-panel h3{margin:0;font-size:16px;font-weight:650;line-height:1.4;letter-spacing:-.015em;}.ds-panel p{margin:6px 0 0;font-size:12px;line-height:1.6;color:var(--muted,#a6b6ab);}@media(prefers-reduced-motion:reduce){.ds-panel{transition:none;}}"
    },
    {
      "name": "NEXUS favorite star",
      "kind": "button",
      "refersTo": "nexus-favorite",
      "description": "The real instrument control; aria-pressed exposes selection. The preview demonstrates both actual visual states.",
      "html": "<div class=\"ds-star-preview\"><button class=\"ds-star\" type=\"button\" aria-label=\"Als Favorit merken: Besuche\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 3 2.78 5.64L21 9.55l-4.5 4.39 1.06 6.2L12 17.21l-5.56 2.93 1.06-6.2L3 9.55l6.22-.91Z\"/></svg></button><button class=\"ds-star\" type=\"button\" aria-label=\"Aus Favoriten entfernen: Besuche\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 3 2.78 5.64L21 9.55l-4.5 4.39 1.06 6.2L12 17.21l-5.56 2.93 1.06-6.2L3 9.55l6.22-.91Z\"/></svg></button></div>",
      "css": ".ds-star-preview{display:flex;gap:12px;padding:12px;background:var(--panel,#141b18);}.ds-star{display:grid;place-items:center;width:40px;min-height:40px;height:40px;padding:0;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--muted,#a6b6ab);cursor:pointer;transition:color .18s ease-out,background .18s ease-out,border-color .18s ease-out;}.ds-star svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}.ds-star[aria-pressed=\"true\"]{background:#29371f;border-color:#617c40;color:var(--cyan,#c4f279);}.ds-star[aria-pressed=\"true\"] svg{fill:currentColor;}.ds-star:hover{background:#253320;border-color:#a8ce78;color:var(--cyan,#c4f279);}.ds-star:focus-visible{outline:2px solid var(--cyan,#c4f279);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-star{transition:none;}}"
    }
  ],
  "narrative": {
    "northStar": "The Field Engineering Console",
    "overview": "NEXUS treats private telemetry as a set of instruments: an ink field, mineral-green bays, decisive display lettering and tabular measurements. Its restrained lime, blue and amber accents distinguish selection, comparison and caution. Real charts and the globe supply the visual media; no raster artwork is required.\n\nThis record describes the built dashboard at `/admin/dashboard`, not a replacement identity for RollTheDice or either game. All `nexus-*` tokens and component examples apply only when the dashboard selects `nexus`. Mission Control remains the default, and LCARS remains a separate selectable design. Their namespaced palette samples preserve existing ownership; their full source styles remain authoritative. The surface-specific composition and direction contract live in `.impeccable/surfaces/app-static-dashboard-html.md`.",
    "keyCharacteristics": [
      "A distinct additional dashboard theme with explicit ownership boundaries.",
      "Heavy authored headings, plain interface labels and tabular measured values.",
      "Flat, ruled instrument surfaces with restrained selection and state color.",
      "Responsive instruments and real-node favorites that retain their controls."
    ],
    "rules": [
      {
        "name": "The Theme Boundary Rule",
        "body": "Apply NEXUS tokens only to the dashboard’s explicit nexus state; preserve Mission Control, LCARS and both game appearances.",
        "section": "overview"
      },
      {
        "name": "The Signal Role Rule",
        "body": "Use lime for action and selected instruments, blue for comparison, amber for caution and danger color for adverse or error state; retain text explanations alongside color.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "Keep numbers tabular, units and scope nearby, and missing or incomplete values explicit; visits never become claims about unique people.",
        "section": "typography"
      },
      {
        "name": "The Readable Geometry Rule",
        "body": "Simple NEXUS plots use measured container geometry; dense phone diagrams keep readable internal dimensions and pan within their own viewport.",
        "section": "layout"
      },
      {
        "name": "The Ruled Bay Rule",
        "body": "Separate NEXUS instruments with tonal surfaces and fine borders; panel and geography-stage shadows are explicitly removed.",
        "section": "elevation"
      },
      {
        "name": "The Real Instrument Rule",
        "body": "Favoriting moves the original live instrument and its IDs into the top bay; it never creates a second chart or a static summary.",
        "section": "components"
      },
      {
        "name": "The Visible Focus Rule",
        "body": "An explicit pin or unpin keeps focus on the moved star and reveals it; background refresh restores focus without moving the viewer’s scroll position.",
        "section": "components"
      }
    ],
    "dos": [
      "Do scope every NEXUS override to the dashboard theme and preserve the two incumbent theme owners.",
      "Do use inline SVG for the reusable instrument and star icons.",
      "Do retain German and English labels, native selects, visible keyboard focus and chart table alternatives.",
      "Do keep favorites local to the verified viewer and show the browser-storage limitation.",
      "Do preserve independent chart selection, measurement definitions, loading, empty, stale and access-loss states."
    ],
    "donts": [
      "Don't promote this dashboard’s palette, rail or component composition into a global game design system.",
      "Don't replace or renumber live instrument IDs when moving favorites.",
      "Don't shrink a dense fixed-width SVG until its labels become unreadable on a phone.",
      "Don't invent zeroes, unique-player totals, conversion claims or source coverage from missing telemetry.",
      "Don't make motion necessary for understanding a selected state or reaching a focused control."
    ]
  }
}
