# Nur beim ersten Start erforderlich. Danach das Passwort aus .env entfernen.
ROLLTHEDICE_ADMIN_USERNAME=Admin
ROLLTHEDICE_ADMIN_PASSWORD=ein-langes-temporaeres-passwort

# In Produktion hinter HTTPS auf 1 setzen, lokal über HTTP auf 0 lassen.
ROLLTHEDICE_COOKIE_SECURE=0

# Optional, aber für eine öffentliche Registrierung empfohlen. Beide Werte im
# Cloudflare-Turnstile-Dashboard anlegen und immer gemeinsam setzen.
ROLLTHEDICE_TURNSTILE_SITE_KEY=
ROLLTHEDICE_TURNSTILE_SECRET=
