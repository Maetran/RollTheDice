# Nur beim ersten Start erforderlich. Danach das Passwort aus .env entfernen.
ROLLTHEDICE_ADMIN_USERNAME=Admin
ROLLTHEDICE_ADMIN_PASSWORD=ein-langes-temporaeres-passwort

# In Produktion hinter HTTPS auf 1 setzen, lokal über HTTP auf 0 lassen.
ROLLTHEDICE_COOKIE_SECURE=0

# Optionaler gemeinsamer Login für kontrollierte Subdomains. Lokal leer lassen;
# in Produktion auf zockdiewandan.online setzen.
ROLLTHEDICE_COOKIE_DOMAIN=

# Feste, vertrauenswürdige Produkt-Origins. Diese Werte sind auch die einzigen
# erlaubten Ziele des Login-Handoffs; keine Pfade oder abschliessenden Slashes.
ROLLTHEDICE_SITE_ORIGIN=https://zockdiewandan.online
ROLLTHEDICE_ZILCH_ORIGIN=https://zilch.zockdiewandan.online

# Direkter Reverse-Proxy-Peer, dessen X-Forwarded-For Uvicorn vertrauen darf.
# Lokal ist das Loopback; auf Produktion den Docker-Bridge-Gateway eintragen.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional, aber für eine öffentliche Registrierung empfohlen. Beide Werte im
# Cloudflare-Turnstile-Dashboard anlegen und immer gemeinsam setzen.
ROLLTHEDICE_TURNSTILE_SITE_KEY=
ROLLTHEDICE_TURNSTILE_SECRET=

# Transactional account email stays disabled until a verified Resend sender and
# a restricted API key have been configured. It sends registration confirmation,
# requested password reset and address confirmation only; it has no inbox.
ROLLTHEDICE_EMAIL_ENABLED=0
ROLLTHEDICE_RESEND_API_KEY=
ROLLTHEDICE_EMAIL_FROM=

# WebAuthn passkeys stay disabled until the HTTPS origins below are live. The
# RP ID must match the hostname in ROLLTHEDICE_SITE_ORIGIN exactly.
ROLLTHEDICE_PASSKEYS_ENABLED=0
ROLLTHEDICE_WEBAUTHN_RP_ID=zockdiewandan.online
ROLLTHEDICE_WEBAUTHN_RP_NAME=Zock die Wand an

# Schutz vor automatisierter Spielanlage und zu vielen parallelen Verbindungen.
ROLLTHEDICE_GAME_CREATE_BURST_MAX=5
ROLLTHEDICE_GAME_CREATE_IP_MAX=30
ROLLTHEDICE_GAME_CREATE_GLOBAL_MAX=300
ROLLTHEDICE_MAX_WEBSOCKETS_PER_ADDRESS=30
ROLLTHEDICE_MAX_WEBSOCKETS_GLOBAL=500

# Zilch ist öffentlich: Gäste können spielen, angemeldete Konten erhalten
# zusätzlich Historie, Statistiken, Awards und Ranglisten-Einträge. Diese
# Allowlist wird nur ausgewertet, wenn der Zielgruppenmodus bewusst auf
# "preview" zurückgestellt wird; sie verleiht keine Adminrechte.
ROLLTHEDICE_ZILCH_PREVIEW_USERNAMES=

# Produktionsmodus: "public" erlaubt Gästen und angemeldeten Konten Zilch.
# "authenticated" und "preview" bleiben als kontrollierte Rückfallmodi bereit.
ROLLTHEDICE_ZILCH_ACCESS_MODE=public

# Sichtbare, rein serverseitige CPU-Denkpause in Sekunden (0 bis 5). Sie
# verändert weder Würfelwahrscheinlichkeiten noch Wertung.
ROLLTHEDICE_ZILCH_CPU_DELAY_SECONDS=1.25

# Optionale Web-Push-Einladungen für öffentliche wartende Spielräume. Alle drei
# Werte gemeinsam setzen; der private VAPID-Key gehört ausschließlich in das
# Produktions-Secret und niemals in Git.
ROLLTHEDICE_WEB_PUSH_VAPID_PUBLIC_KEY=
ROLLTHEDICE_WEB_PUSH_VAPID_PRIVATE_KEY=
ROLLTHEDICE_WEB_PUSH_VAPID_SUBJECT=
# Erinnerungen: separater Konto-Opt-in, nur an spielfreien Tagen,
# zufällig zwischen 17 und 21 Uhr (Europe/Zurich); keine feste Versandstunde.
